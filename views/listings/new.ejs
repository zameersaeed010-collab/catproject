<% layout("/layouts/boilerplate.ejs")%>
<body>
    <h3>New-Listing</h3>
   <div class="row">
    <div class="col-8 offset-2">
        <form action="/listings" , method="post" enctype="multipart/form-data">
     <div>
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title" class="form-control" name="listing[title]"/>
    </div>
    <div>
        <label for="description" class="form-label">Description:</label>
        <input type="text" id="description" class="form-control" name="listing[description]"/>    
    </div>
    <div>
        <label for="price" class="form-label">Price:</label>
        <input type="text" id="price" class="form-control" name="listing[price]"/>
    </div>
    <div>
        <label for="image" class="form-label">Image:</label>
        <input type="file" id="image" class="form-control" name="listing[image]"/>
    </div>
    <div>
        <label for="location" class="form-label">Location:</label>
        <input type="text" id="location" class="form-control" name="listing[location]"/>
    </div>
    <div>
        <label for="country" class="form-label">Country:</label>
        <input type="text" id="country" class="form-control" name="listing[country]"/>
    </div>
    <button type="submit" class="btn btn-primary mt-3 mb-3">Create-Listing</button>
   </form>
    </div>
   </div>
</body>
