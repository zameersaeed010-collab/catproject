<% layout("/layouts/boilerplate.ejs")%>
<body>


    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
           align-items: center;

        }
        .filter{
        text-align: center;
        margin-right: 2rem;
        margin-top: 1.5rem;
        opacity: 0.7;
    
        }
        .filter:hover{
            opacity: 1;
            font-size: 1.1rem;
            cursor: pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }

        .texinfo{
            display: none;
        }

    .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    padding: 0.5rem 1rem;
    margin-top: 1rem;
    margin-left: 3rem;
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
}

    </style>

    <div id="filters">
         <div class="filter">
        <a href="/listings/Trending">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>
    </div>

          <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>

          <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Iconic City</p>
        </div>


          <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>


           <div class="filter">
            <div><i class="fa-solid fa-hotel"></i></div>
            <p>Castles</p>
        </div>


          <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pool</p>
        </div>


          <div class="filter">
            <div><i class="fa-brands fa-mailchimp"></i></div>
            <p>Camping</p>
        </div>


          <div class="filter">
            <div><i class="fa-brands fa-free-code-camp"></i></div>
            <p>Farms</p>
        </div>


          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Arctic</p>
        </div>

  <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">
            Display total after taxes
        </label>
    </div>
</div>
    </div>

    <div class="row row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 ">
        
  <% for (let listing of allListing) { %>

  <a href="/listings/<%= listing._id %>">

            <div class="card card-listings">
            <img src="<%=listing.image.url%>" class="card-img-top" alt="..." style="height: 20rem;  ">
            <div class="card-img-overlay">zameer</div>
            <div class="card-body">
            <p class="card-text"><%=listing.title%> <br>
            &#8360.<%=listing.price.toLocaleString("en-PK")%>
                
            &nbsp; &nbsp; <i class="texinfo">+18% GST</i>
        </p>

            </div>
            </div>
<% } %>

</a>

      </div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script>
    let texinfo = document.getElementById("switchCheckDefault");
    texinfo.addEventListener("click",()=>{
        let texinfo = document.getElementsByClassName("texinfo")
        for(info of texinfo){
            if(info.style.display != "inline"){
                
                info.style.display = "inline"
            }
            else{
                info.style.display = "none"
            }
        }
    })



</script>
</body>
